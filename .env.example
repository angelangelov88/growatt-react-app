# Server-only settings, read by the /api functions. None of them may start
# with VITE_: Vite builds those into the JavaScript that every visitor gets.
# Locally, run the app with `pnpm dev:api` (vercel dev). On Vercel, set the
# same names in Project Settings → Environment Variables.

# The address the app is served from. Requests that change data must come
# from here. Locally: http://localhost:3000. Leave it unset for Vercel
# previews: they use the addresses Vercel gives each deployment and branch.
APP_ORIGIN=

# Supabase (Project Settings → API). The secret key can do anything, so it's
# only used to delete accounts and in tests.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Google sign-in (Google Cloud → APIs & Services → Credentials → the OAuth
# client). The same client ID and secret as Supabase's Google provider, which
# checks the ID tokens this app gets. Without them, only email login works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres as the app_server role, through the transaction pooler (port 6543).
DATABASE_URL=

# Encrypts each user's saved Growatt and Octopus details. 32 random bytes as
# base64: openssl rand -base64 32. Losing it makes the saved details
# unreadable; users would have to enter them again.
CREDENTIALS_ENC_KEY_V1=

# Lets the GitHub workflow run the scheduled job (/api/cron/update). Also a
# GitHub Actions secret with the same value. openssl rand -base64 32
CRON_SECRET=

# Only for pnpm check:database (and the same GitHub Actions secret): Postgres
# as the ci_check role, which can read the catalog and nothing else. Same
# pooler address as DATABASE_URL.
CI_DATABASE_URL=
